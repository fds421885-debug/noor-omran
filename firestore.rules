rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Participants profiles and roles
    match /participants/{participantId} {
      allow read, write: if true;
    }

    // System settings (schools, grades, honor board)
    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    // Quizzes bank and generated tests
    match /quizzes/{quizId} {
      allow read, write: if true;
    }

    // Live competition rooms
    match /live_rooms/{roomId} {
      allow read, write: if true;
    }

    // Connection verification endpoint
    match /test/{docId} {
      allow read, write: if true;
    }

    // Catch-all safety default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
